      "options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["last"]}},
      "targets":[{"expr":"deriv(federation_outbox_deadletter[5m])","legendFormat":"{{bu}} dead-letter growth","refId":"A"}],
      "title":"Dead-Letter Growth Rate (derivative, rows/s)",
      "type":"timeseries"
    }
