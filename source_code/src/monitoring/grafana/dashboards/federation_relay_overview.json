    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 100,
      "title": "▶ Relay Efficiency & Failure Trends",
      "type": "row"
    },
    {
      "datasource":"Prometheus",
      "description": "What % of messages have been successfully relayed vs dead-lettered. Below 99% needs investigation.",
      "fieldConfig":{
        "defaults":{
          "unit":"percent",
          "color":{"mode":"thresholds"},
          "thresholds":{"steps":[{"color":"red","value":null},{"color":"orange","value":95},{"color":"green","value":99}]}
        },"overrides":[]
      },
      "gridPos":{"h":6,"w":8,"x":0,"y":13},
      "id":5,
      "options":{"reduceOptions":{"calcs":["last"],"values":false},"colorMode":"background","orientation":"auto"},
      "targets":[{"expr":"100 * sum(federation_outbox_processed) / (sum(federation_outbox_processed) + sum(federation_outbox_deadletter) + 0.001)","legendFormat":"Efficiency","refId":"A"}],
      "title":"Relay Efficiency %",
      "type":"stat"
    },
    {
      "datasource":"Prometheus",
      "description": "Is each BU's relay currently processing? Green if rate > 0, red if flatlined. If both are red and pending is growing, the relay loop has stopped.",
      "fieldConfig":{
        "defaults":{
          "unit":"ops",
          "color":{"mode":"thresholds"},
          "thresholds":{"steps":[{"color":"red","value":null},{"color":"green","value":0.001}]}
        },"overrides":[]
      },
      "gridPos":{"h":6,"w":8,"x":8,"y":13},
      "id":6,
      "options":{"reduceOptions":{"calcs":["last"],"values":false},"colorMode":"background","orientation":"horizontal"},
      "targets":[{"expr":"rate(federation_outbox_processed[5m])","legendFormat":"{{bu}}","refId":"A"}],
      "title":"Per-BU Relay Active? (rate > 0 = running)",
      "type":"stat"
    },
    {
      "datasource":"Prometheus",
      "description": "Growth rate of dead-letter rows. Any positive slope = relay is failing and not recovering — check Kafka connectivity.",
      "fieldConfig":{"defaults":{"unit":"ops","color":{"mode":"palette-classic"}},"overrides":[]},
      "gridPos":{"h":6,"w":8,"x":16,"y":13},
