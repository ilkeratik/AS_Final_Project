# .env.example — nopCommerce Two-BU Environment Template
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# Docker Compose reads .env automatically.
# All values can also be set as shell environment variables.
#
# ⚠️  Never commit .env with real credentials.

# ── BU-A ──────────────────────────────────────────────────────────────────────
# Postgres password for BU-A's dedicated postgres container
BUA_DB_PASS=CHANGE_ME_BUA_DB_PASSWORD
# Admin user password created during first install
BUA_ADMIN_PASS=CHANGE_ME_BUA_ADMIN_PASSWORD

# ── BU-B ──────────────────────────────────────────────────────────────────────
BUB_DB_PASS=CHANGE_ME_BUB_DB_PASSWORD
BUB_ADMIN_PASS=CHANGE_ME_BUB_ADMIN_PASSWORD

# ── Federation services (optional) ────────────────────────────────────────────
# Meilisearch master key. Leave empty for local/demo (open instance).
# Set a strong key for any shared/remote deployment.
MEILI_MASTER_KEY=

# Seconds platform.sh waits for Keycloak OIDC readiness during start (default 120).
KEYCLOAK_READY_TIMEOUT=120

# Note: Keycloak admin console defaults to admin/admin and the OIDC client secrets
# (bu-a-secret / bu-b-secret) are demo values seeded by platform.sh. Replace them
# in docker-compose.federation.yml + keycloak-realm.json before any real deployment.

